# Create this file locally, fill in base64-encoded values, and apply once.
# DO NOT commit real secrets to git.
apiVersion: v1
kind: Secret
metadata:
  name: inference-secrets
type: Opaque
data:
  # echo -n "my-bucket-name" | base64
  s3_bucket: <BUCKET_NAME>
  sqs_queue_url: <SQS_QUEUE_URL>
---
apiVersion: v1
kind: Secret
metadata:
  name: aws-credentials
type: Opaque
data:
  # aws configure export-credentials --profile seis765 --format env
  # then: echo -n "<value>" | base64
  AWS_ACCESS_KEY_ID: <ACCESS_KEY_ID>
  AWS_SECRET_ACCESS_KEY: <SECRET_ACCESS_KEY>
  AWS_SESSION_TOKEN: <SESSION_TOKEN>